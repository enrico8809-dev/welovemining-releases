{
  "name": "wlm-trader-app",
  "productName": "WLM Trader",
  "version": "1.0.0",
  "description": "WLM Trader: control your WeLoveMining trading bot from Windows and Android",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build:renderer && cap sync android",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "build": {
    "appId": "za.co.welovemining.trader",
    "productName": "WLM Trader",
    "copyright": "WeLoveMining Pty Ltd",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "../trading-bot",
        "to": "trading-bot",
        "filter": [
          "**/*",
          "!.venv/**",
          "!data/cache/**",
          "!data/*.db",
          "!data/*.json",
          "!logs/**",
          "!.env",
          "!backtest/results/**",
          "!**/__pycache__/**",
          "!.pytest_cache/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "WLM-Trader-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WLM Trader"
    },
    "publish": null
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
