# Copy this file to .env and fill it in. NEVER commit .env or share it.
# API keys: enable "Read" and "Spot trading" ONLY. Never enable withdrawals.
EXCHANGE=binance
API_KEY=
API_SECRET=
LIVE_TRADING=false
MAX_ORDER_USDT=20

# Telegram alerts and commands (optional). See the top of bot/telegram.py for setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp alerts via CallMeBot (optional, send-only). See the top of bot/whatsapp.py for setup.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Forex via MetaTrader 5 (optional). Install the MT5 terminal from your broker and log in.
# Leave FOREX_LIVE_TRADING=false: the bot then only trades on a DEMO account.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
FOREX_LIVE_TRADING=false
