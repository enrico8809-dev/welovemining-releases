# Copy this file to .env and fill it in. NEVER commit .env or share it.
# API keys: enable "Read" and "Spot trading" ONLY. Never enable withdrawals.
EXCHANGE=binance
API_KEY=
API_SECRET=
LIVE_TRADING=false
MAX_ORDER_USDT=20

# Telegram alerts and commands (optional). See the top of bot/telegram.py for setup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
