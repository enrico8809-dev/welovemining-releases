# Copy to .env (gitignored) and fill in. Secret keys must live ONLY on the backend.
# Local dev: firebase emulators reads .env. Production: use `firebase functions:secrets:set`.

# PayFast (https://www.payfast.co.za) — use sandbox values while testing
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Yoco (https://www.yoco.com) — online payments secret key
YOCO_SECRET_KEY=

# Ozow (https://www.ozow.com)
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_IS_TEST=true

# SnapScan (https://www.snapscan.co.za)
SNAPSCAN_MERCHANT_ID=
SNAPSCAN_API_KEY=

# Where PayFast/Ozow redirect the customer back to (your app deep link or web page)
RETURN_URL=mrdweedery://pay/return
CANCEL_URL=mrdweedery://pay/cancel
